{
  "expo": {
    "name": "FleetPulse Livreur",
    "slug": "fleetpulse-livreur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FleetPulse Livreur vérifie que vous êtes dans l'une de vos zones avant de vous déclarer disponible."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FleetPulse Livreur utilise l'appareil photo pour scanner le QR des colis à la collecte.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "fleetpulse-livreur",
    "backgroundColor": "#0A0F1A"
  }
}
